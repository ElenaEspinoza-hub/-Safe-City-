# MapLibre + MapTiler Cloud
# Copia este archivo a .env y completa los valores.

# API key de MapTiler Cloud
VITE_MAPTILER_KEY=TU_MAPTILER_KEY

# Estilo de mapa de MapTiler (opcional)
# Ejemplos: streets-v2, basic-v2, satellite, dataviz
VITE_MAPTILER_MAP_ID=streets-v2

# URL de estilo personalizada (opcional, tiene prioridad sobre MapTiler)
# VITE_MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=TU_MAPTILER_KEY

# InsForge (OAuth Google/GitHub)
# URL base del backend InsForge (ejemplo: https://TU_APPKEY.us-east.insforge.app)
VITE_INSFORGE_URL=

# URL publica del Worker de Cloudflare que revisa fotografias. La clave de
# OpenAI se guarda solamente como secreto del Worker, nunca con VITE_.
VITE_IMAGE_REVIEW_URL=https://TU-WORKER.TU-SUBDOMINIO.workers.dev

# Clave pública ANON de InsForge (no uses API key admin en frontend)
VITE_INSFORGE_ANON_KEY=

# Supabase: reportes y noticias. La URL no es secreta; coloca la clave anon pública del proyecto.
VITE_SUPABASE_NEWS_URL=https://faczibrwcktjypkxxvgo.supabase.co/rest/v1/safecity-noticias
VITE_SUPABASE_ANON_KEY=
